claudeLocal() {
	export CLAUDE_CODE_AUTO_COMPACT_WINDOW=250000
	export ANTHROPIC_BASE_URL="https://oemer.tail430415.ts.net:8080"
	export ANTHROPIC_AUTH_TOKEN="moldere"
	unset ANTHROPIC_API_KEY
	claude --settings '{"env":{"CLAUDE_CODE_ATTRIBUTION_HEADER":"0","CLAUDE_CODE_ENABLE_TELEMETRY":"0","CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC":"1"}}' --model bonsai2 --exclude-dynamic-system-prompt-sections "$@"
}

_lock_hash() {
	{
		shasum -a 256 package-lock.json
		if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
			git ls-files -z -- ':(glob)**/package.json' | xargs -0 shasum -a 256
		else
			shasum -a 256 package.json
		fi
		node -v
	} | shasum -a 256 | cut -d' ' -f1
}

qins() {
	[[ -f package-lock.json ]] || {
		echo "no package-lock.json here"
		return 1
	}

	if [[ $# -eq 0 && -f node_modules/.lock-hash && "$(<node_modules/.lock-hash)" == "$(_lock_hash)" ]]; then
		echo "deps unchanged, skipping install"
		return 0
	fi

	npm i --prefer-offline --no-fund --no-audit --loglevel=error --progress=false --no-update-notifier "$@" &&
		_lock_hash >node_modules/.lock-hash
}

refresh() {
	git fetch
	git pull
	qins
}

co() {
	if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
		echo "uncommitted changes, not checking out"
		git status --short --untracked-files=no
		return 1
	fi

	git fetch
	git checkout "$1"
	git pull
	qins
}

tss() {
	npx ts-node main.ts
}

# restart mac docker (cause it's fucked up bro)
rmd() {
	sudo pkill docker
	sudo pkill -9 -f 'Docker Desktop'
	sudo pkill -9 -f 'com.docker'
	sudo pkill -9 -f docker

	sleep 2

	command open -ga "Docker Desktop"
}

k() {
	local pids
	pids=($(lsof -ti:"$1"))

	if [[ ${#pids[@]} -gt 0 ]]; then
		echo "Killed processes on port $1"
		kill -9 "${pids[@]}"
	else
		echo "No process found on port $1"
	fi
}

s() {
	echo "running s function...\n"
	local containers
	containers=$(docker ps -q)

	if [[ -n "$containers" ]]; then
		docker stop $(docker ps -q) >/dev/null
		echo "Stopped containers:\n$containers"
	else
		echo "No running containers to stop."
	fi

	local ports
	ports=(
		# BEs
		3021 3022 3023 3024 3025 3026 3027 3028 3029
		# FEs
		3000 3001
		# MySQLs
		3307 3306
		# PostgreSQL
		5432
	)

	local port
	for port in "${ports[@]}"; do
		k "$port"
	done

	echo "\nunsetting environment variables...\n"
	unset databaseUri
	unset postgresUri
	unset ENV_PRIVATE_KEY
	unset cloudFrontKeyPairId
	unset cloudFrontPrivateKey
	unset AWS_ACCESS_KEY_ID
	unset AWS_SECRET_ACCESS_KEY
	unset DB_ENV
}

installed() {
	sudo pacman -Qe
}

removeorphans() {
	sudo pacman -Rns $(pacman -Qdtq)
}

wtfis() {
	if [ $# -ne 1 ]; then
		echo "Please provide a package name..."
		return 1
	fi

	pacman -Qi "$1" | grep Reason

	echo "pactree: "
	pactree -r "$1"

}

repoHere() {
	if [ $# -ne 1 ]; then
		echo "Please provide a repo name..."
		return 1
	fi

	gh repo create "$1" --public --source=. --remote=upstream
}

compress() {
	if [ $# -ne 1 ]; then
		echo "Usage: compress /absolute/path/to/dir"
		return 1
	fi

	target="$1"
	if [ ! -d "$target" ]; then
		echo "Error: $target is not a directory"
		return 1
	fi

	parent=$(dirname "$target")
	base=$(basename "$target")
	tarball="${base}.tar.gz"

	echo "parent $parent"
	echo "base $base"
	echo "tarball $tarball"

	echo "Compressing as $tarball to current dir..."
	tar -czf "$tarball" -C "$parent" "$base"
}

alias decompress="tar -xzf"

open() {
	(
		set +m
		xdg-open "$@" >/dev/null 2>&1 </dev/null &
	)
}

# Write iso file to sd card
iso2sd() {
	if [ $# -ne 2 ]; then
		echo "Usage: iso2sd <input_file> <output_device>"
		echo "Example: iso2sd ~/Downloads/ubuntu-25.04-desktop-amd64.iso /dev/sda"
		echo -e "\nAvailable SD cards:"
		lsblk -d -o NAME | grep -E '^sd[a-z]' | awk '{print "/dev/"$1}'
	else
		sudo dd bs=4M status=progress oflag=sync if="$1" of="$2"
		sudo eject "$2"
	fi
}

# Format an entire drive for a single partition using ext4
format-drive() {
	if [ $# -ne 2 ]; then
		echo "Usage: format-drive <device> <name>"
		echo "Example: format-drive /dev/sda 'My Stuff'"
		echo -e "\nAvailable drives:"
		lsblk -d -o NAME -n | awk '{print "/dev/"$1}'
	else
		echo "WARNING: This will completely erase all data on $1 and label it '$2'."
		read "confirm?Are you sure you want to continue? (y/N): "
		if [[ "$confirm" =~ ^[Yy]$ ]]; then
			sudo wipefs -a "$1"
			sudo dd if=/dev/zero of="$1" bs=1M count=100 status=progress
			sudo parted -s "$1" mklabel gpt
			sudo parted -s "$1" mkpart primary ext4 1MiB 100%
			sudo mkfs.ext4 -L "$2" "$([[ $1 == *"nvme"* ]] && echo "${1}p1" || echo "${1}1")"
			sudo chmod -R 777 "/run/media/$USER/$2"
			echo "Drive $1 formatted and labeled '$2'."
		fi
	fi
}

# Transcode a video to a good-balance 1080p
transcode-video-1080p() {
	ffmpeg -i "$1" -vf scale=1920:1080 -c:v libx264 -preset fast -crf 23 -c:a copy "${1%.*}"-1080p.mp4
}

# Transcode any image to JPG image that's great for shrinking wallpapers
img2jpg() {
	magick "$1" -quality 95 -strip "${1%.*}".jpg
}

img2jpg-small() {
	magick "$1" -resize 1080x\> -quality 95 -strip "${1%.*}".jpg
}

img2png() {
	magick "$1" -strip -define png:compression-filter=5 \
		-define png:compression-level=9 \
		-define png:compression-strategy=1 \
		-define png:exclude-chunk=all \
		"${1%.*}.png"
}

start() {
	cd ~/projects || return
	tmux
}

# rollback: interactively undo a pacman transaction using snapper snapshots.
# zsh heavy stuff so shellcheck is off
# shellcheck disable=all
rollback() {
	# this apprently resets everything that may have drifted in an interactive shell
	# again apparently this is quite important to use esp. in scripts that do array index work
	emulate -L zsh
	setopt pipefail

	local cfg=root
	sudo -v || return 1

	# Machine readable snapshot list: number, type, pre-number, date, description
	local raw
	raw=$(sudo snapper --csvout --separator $'\t' -c $cfg list \
		--columns number,type,pre-number,date,description) || {
		print -u2 "rollback: could not read snapper list for config '$cfg'"
		return 1
	}

	typeset -A s_type s_date s_desc post_of
	local line num
	local -a f
	for line in ${(f)raw}; do
		f=("${(@ps:\t:)line}") # keeps empty fields
		num=${f[1]}
		[[ $num == <-> ]] || continue # skips the header row
		s_type[$num]=${f[2]}
		s_date[$num]=${f[4]}
		s_desc[$num]=${f[5]}
		[[ ${f[2]} == post && -n ${f[3]} ]] && post_of[${f[3]}]=$num
	done

	sudo snapper -c $cfg list
	print

	read -q "?Would you like to roll back an install? [y/N] " || {
		print
		return 0
	}
	print
	print

	local from to
	read -r "from?From (the snapshot BEFORE the change, usually a 'pre'): "
	if [[ $from != <-> || $from == 0 || -z ${s_type[$from]} ]]; then
		print -u2 "rollback: snapshot '$from' does not exist (or is 0, the live system)"
		return 1
	fi

	# Default "to" is the matching post snapshot, so a pre/post pair is one Enter away
	local def=${post_of[$from]:-0}
	read -r "to?To [$def]: "
	to=${to:-$def}
	if [[ $to != <-> || -z ${s_type[$to]} ]]; then
		print -u2 "rollback: snapshot '$to' does not exist"
		return 1
	fi
	if ((to != 0 && to <= from)); then
		print -u2 "rollback: 'to' ($to) must be newer than 'from' ($from), or 0 for the live system"
		return 1
	fi

	local date_from=${s_date[$from]}
	local date_to=${s_date[$to]:-now}
	((to == 0)) && date_to="now (current system)"

	# Preview what will change
	local changes
	changes=$(sudo snapper -c $cfg status $from..$to) || return 1
	local count=${#${(f)changes}}

	print
	print "Files affected: $count"
	print -l -- ${${(f)changes}[1,20]}
	((count > 20)) && print "... and $((count - 20)) more"

	if print -r -- $changes | grep -q '/usr/lib/modules/'; then
		print
		print -P "%F{yellow}Warning:%f this range includes kernel modules. /boot is not snapshotted,"
		print "so after rolling back, reinstall the kernel (sudo pacman -S linux) before rebooting."
	fi

	print
	print "System changes from version: $to (${s_desc[$to]:-current}) from date: $date_to will be undone."
	print "The system will be rolled back to version: $from (${s_desc[$from]}) from date: $date_from."
	print

	local answer
	read -r "answer?Type 'confirm' to proceed: "
	if [[ $answer != confirm ]]; then
		print "Aborted. Nothing changed."
		return 0
	fi

	# Safety net: snapshot the current state first, so the rollback itself can be undone
	local safety
	safety=$(sudo snapper -c $cfg create --print-number --cleanup-algorithm number \
		--description "before rollback $from..$to") || {
		print -u2 "rollback: could not create safety snapshot, aborting"
		return 1
	}

	sudo snapper -c $cfg undochange $from..$to || return 1

	print
	print "Done. To undo this rollback: sudo snapper -c $cfg undochange $safety..0"
}
