[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-space": "agent::ToggleFocus",
      "ctrl-b": ["workspace::SendKeystrokes", "ctrl-space ctrl-b"],
      "shift-tab": "terminal_panel::Toggle",
      "alt-f": "projects::OpenRecent",
    },
  },
  {
    "context": "ThreadsSidebar",
    "bindings": {
      "f19": "editor::MoveDown",
    },
  },
  {
    "context": "ThreadsSidebar && !Editor",
    "bindings": {
      "a": "agents_sidebar::FocusSidebarFilter",
    },
  },
  {
    "context": "Dock",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "Editor && mode == full && (vim_mode == normal || vim_mode == insert)",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-t": "agent::AddSelectionToThread",
      "shift-tab": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Editor && mode == full && vim_mode == visual",
    "bindings": {
      "ctrl-t": "agent::AddSelectionToThread",
    },
  },
  {
    "context": "(vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      "-": "vim::EndOfLine",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::HelixJumpToWord",
    },
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "t": ["vim::PushFindForward", { "before": false, "multiline": false }],
      "shift-y": ["workspace::SendKeystrokes", "y $"],
      "ctrl-d": ["workspace::SendKeystrokes", "1 5 ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "1 5 ctrl-u z z"],
      "ctrl-c": "editor::Cancel",
      "ctrl-s": "workspace::Save",
      "ctrl-p": "file_finder::Toggle",
      "ctrl-space": "agent::ToggleFocus",
      "ctrl-b": ["workspace::SendKeystrokes", "ctrl-space ctrl-b"],
      "alt-up": "vim::ResizePaneUp",
      "alt-down": "vim::ResizePaneDown",
      "alt-left": "vim::ResizePaneRight",
      "alt-right": "vim::ResizePaneLeft",
      "f2": "vim::ResizePaneLeft",
      "f3": "vim::ResizePaneRight",
      "g r": "editor::FindAllReferences",
      "space e": "project_panel::Toggle",
      "space o": ["workspace::SendKeystrokes", "cmd-alt-j f19"],
      "space f": "text_finder::Toggle",
      "space space": "tab_switcher::Toggle",
      "space ,": "editor::Format",
      "space p": ["task::Spawn", { "task_name": "Open Project" }],
      "space b b": "pane::AlternateFile",
      "space b d": "pane::CloseActiveItem",
      "space s h": "pane::SplitDown",
      "space s v": "pane::SplitRight",
      "space s r": ["pane::DeploySearch", { "replace_enabled": true }],
      "space c a": "editor::ToggleCodeActions",
      "space c u": "editor::UnfoldLines",
      "space c f": "editor::Fold",
      "space c v": [
        "action::Sequence",
        ["editor::ToggleInlineDiagnostics", "editor::ToggleInlayHints"],
      ],
      "space c l": "outline_panel::ToggleFocus",
      "space c t": ["task::Spawn", { "task_name": "gomodifytags json" }],
      "space r c": "editor::Rename",
      "space r m": ["workspace::SendKeystrokes", ": %s/\\r//g enter"],
      "space x x": "diagnostics::Deploy",
      "space x shift-x": "diagnostics::DeployCurrentFile",
      "space g d": "editor::GoToDefinition",
      "space g g": [
        "task::Spawn",
        { "task_name": "lazygit", "reveal_target": "center" },
      ],
      "space g s": "git_panel::ToggleFocus",
      "space g b": "git::Blame",
      "space d o": "git::Diff",
      "space d c": "pane::CloseActiveItem",
      "space t t": ["task::Spawn", { "task_name": "jest current file" }],
    },
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "shift-s": "vim::PushAddSurrounds",
      "ctrl-s": [
        "action::Sequence",
        ["workspace::Save", "vim::SwitchToNormalMode"],
      ],
      "space r c": "editor::Rename",
    },
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-s": ["action::Sequence", ["workspace::Save", "vim::NormalBefore"]],
      "ctrl-k": "editor::ShowSignatureHelp",
    },
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-e": "editor::Cancel",
      "tab": null,
    },
  },
  {
    "context": "Editor && in_snippet && has_next_tabstop",
    "bindings": {
      "tab": "editor::NextSnippetTabstop",
    },
  },
  {
    "context": "Editor && in_snippet && has_previous_tabstop",
    "bindings": {
      "shift-tab": "editor::PreviousSnippetTabstop",
    },
  },
  {
    "context": "Editor && vim_mode == insert && extension == ts",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "escape ^ \" z y g _ ^ \" _ D A logger.info(': space ', space ctrl-r z ) escape ^ f ' a ctrl-r z",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu && extension == ts",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "^ \" z y g _ ^ \" _ D A logger.info(': space ', space ctrl-r z ) escape ^ f ' a ctrl-r z escape l",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == insert && (extension == tsx || extension == js || extension == jsx || extension == mjs || extension == cjs)",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "escape ^ \" z y g _ ^ \" _ D A console.log(': space ', space ctrl-r z ) escape ^ f ' a ctrl-r z",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu && (extension == tsx || extension == js || extension == jsx || extension == mjs || extension == cjs)",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "^ \" z y g _ ^ \" _ D A console.log(': space ', space ctrl-r z ) escape ^ f ' a ctrl-r z escape l",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == insert && (extension == py || extension == lua)",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "escape ^ \" z y g _ ^ \" _ D A print(': space ', space ctrl-r z ) escape ^ f ' a ctrl-r z",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu && (extension == py || extension == lua)",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "^ \" z y g _ ^ \" _ D A print(': space ', space ctrl-r z ) escape ^ f ' a ctrl-r z escape l",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == insert && extension == go",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "escape ^ \" z y g _ ^ \" _ D A fmt. P rintf(\": space %+v\\n\", space ctrl-r z ) escape ^ f \" a ctrl-r z",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu && extension == go",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "^ \" z y g _ ^ \" _ D A fmt. P rintf(\": space %+v\\n\", space ctrl-r z ) escape ^ f \" a ctrl-r z escape l",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == insert && extension == rs",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "escape ^ \" z y g _ ^ \" _ D A println!(\": space {:?}\", space ctrl-r z ) escape ^ f \" a ctrl-r z",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu && extension == rs",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "^ \" z y g _ ^ \" _ D A println!(\": space {:?}\", space ctrl-r z ) escape ^ f \" a ctrl-r z escape l",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == insert && (extension == sh || extension == bash || extension == zsh)",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "escape ^ \" z y g _ ^ \" _ D A echo space \" space $ ctrl-r z \" escape ^ f \" a ctrl-r z",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu && (extension == sh || extension == bash || extension == zsh)",
    "bindings": {
      "ctrl-g": [
        "workspace::SendKeystrokes",
        "^ \" z y g _ ^ \" _ D A echo space \" space $ ctrl-r z \" escape ^ f \" a ctrl-r z escape l",
      ],
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-n": "terminal::ToggleViMode",
      "alt-f": "projects::OpenRecent",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "alt-left": ["workspace::IncreaseActiveDockSize", { "px": 0 }],
      "alt-right": ["workspace::DecreaseActiveDockSize", { "px": 0 }],
      "ctrl-enter": "workspace::NewTerminal",
      "shift-left": "pane::ActivatePreviousItem",
      "shift-right": "pane::ActivateNextItem",
    },
  },
  {
    "context": "Terminal && vi_mode",
    "bindings": {
      "ctrl-c": ["terminal::SendKeystroke", "escape"],
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-b": "workspace::ToggleZoom",
    },
  },
  {
    "context": "AgentPanel > Terminal",
    "bindings": {
      "shift-tab": ["terminal::SendKeystroke", "shift-tab"],
    },
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-c": "menu::Cancel",
    },
  },
  {
    "context": "TabSwitcher || (TabSwitcher > Picker > Editor)",
    "bindings": {
      "ctrl-d": "tab_switcher::CloseSelectedItem",
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "space e": "project_panel::Toggle",
    },
  },
  {
    "context": "!Editor && !Terminal",
    "bindings": {
      "space f": "text_finder::Toggle",
    },
  },
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-p": "file_finder::Toggle",
      "space e": "project_panel::Toggle",
      "space o": ["workspace::SendKeystrokes", "cmd-alt-j f19"],
      "space f": "text_finder::Toggle",
      "space space": "tab_switcher::Toggle",
      "space p": ["task::Spawn", { "task_name": "Open Project" }],
    },
  },
]
