{
  "tsrafce": {
    "prefix": "tsrafce",
    "body": [
      "import React from 'react';",
      "type Props = {};",
      "",
      "const ${1:ComponentName}: React.FC<Props> = ({}: Props) => {",
      "  return (",
      "    <div>",
      "      {/* Your component JSX */}",
      "    </div>",
      "  );",
      "};",
      "",
      "export default $1;"
    ]
  },
  "debugg": {
    "prefix": "debugg",
    "body": ["style={{border: '4px solid red'}}"]
  }
}
