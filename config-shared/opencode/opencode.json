{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "lsp": true,
  "share": "disabled",
  "snapshots": false,
  "experimental": {
    "todo": true
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    }
  },
  "providers": {
    "llama-text": {
      "name": "llama.cpp",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{file:~/.config/opencode/.opencode-tailscale-url}:8080/v1",
        "apiKey": "moldere",
        "compaction": {
          "type": "summary"
        }
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "bonsai2-27b": {
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 90112,
            "output": 8192
          }
        },
        "qwen3.6-35b-a3b-vl": {
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "llama-text/bonsai2-27b",
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "description": "Exploration, research, and code review. Reports findings; never edits.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "basic-memory": {
        "type": "local",
        "command": [
          "basic-memory",
          "mcp"
        ],
        "disabled": false
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp",
          "--api-key",
          "{file:~/.config/opencode/.opencode-context7-api-key}"
        ],
        "disabled": false
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "x-api-key": "{file:~/.config/opencode/.opencode-exa-api-key}"
        },
        "disabled": true
      },
      "revenuecat": {
        "type": "remote",
        "url": "https://mcp.revenuecat.ai/mcp"
      },
      "search-mcp": {
        "type": "remote",
        "url": "{file:~/.config/opencode/.opencode-tailscale-url}:3900/mcp",
        "disabled": false
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "aws *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "curl *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "node -e *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "node --eval *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "node -p *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "node --print *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npx ts-node -e *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npx tsx -e *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "ts-node -e *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "tsx -e *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "bun -e *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "deno eval *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "perl -e *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "ruby -e *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "python *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "python3 *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sed *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "stow *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "./stow.sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "./re-stow.sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "./setup.sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "./nvidia.sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit --no-verify *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit -n *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit -m *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git checkout -- *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git restore *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git rebase *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit --amend *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git filter-branch *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git filter-repo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git branch -D *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git tag -d *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git stash drop *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git stash clear *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh pr create *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh pr comment *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh pr review *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh pr merge *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh pr close *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh pr edit *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh issue create *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh issue comment *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh release create *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh secret set *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh workflow run *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh repo delete *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm run destroy *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm run local-db:refresh *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm run eject *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm run reset-db *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm run typeorm:revert *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm run deploy *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm run npm-publish *",
      "effect": "deny"
    }
  ]
}
